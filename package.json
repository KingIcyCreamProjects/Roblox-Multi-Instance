{
  "name": "roblox-multi-instance",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:local": "tauri build -c \"{\\\"bundle\\\":{\\\"createUpdaterArtifacts\\\":false}}\"",
    "lint": "eslint . && prettier --check src e2e",
    "format": "prettier --write src e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tauri build --debug --no-bundle && wdio run e2e/wdio.conf.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
